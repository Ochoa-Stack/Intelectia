<UserControl x:Class="Intelectia.WPF.Views.BookDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header con botón de regreso -->
        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GoBackCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Padding="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconArrowLeft}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Volver"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Title}" Style="{StaticResource TextHeading}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Contenido del detalle -->
        <Grid Grid.Row="1" Visibility="{Binding Book, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: portada + precio + botón -->
            <Border Grid.Column="0" Padding="24">
                <StackPanel>
                    <Border Width="220" Height="300" HorizontalAlignment="Center"
                            Background="{StaticResource SurfaceBrush}" CornerRadius="12" Margin="0,0,0,24">
                        <Path Data="{StaticResource IconBook}"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Width="64" Height="64" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Style="{StaticResource TextHeading}"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <Run Text="$"/>
                        <Run Text="{Binding Book.Price, StringFormat='{}{0:F2}'}"/>
                    </TextBlock>

                    <Button Command="{Binding AddToCartCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="0,12"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Agregar al carrito " Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconCart}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource ErrorBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Columna derecha: título, autor, metadatos, etc -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,24,40,24">
                <StackPanel>
                    <TextBlock Text="{Binding Book.Title}" Style="{StaticResource TextHeading}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Book.Author}" Style="{StaticResource TextSubhead}"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}"
                              Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource TextBody}" Margin="6,0,0,0">
                            <Run Text="{Binding Book.AverageRating, StringFormat='{}{0:F1}'}"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding Book.ReviewCount}"/>
                            <Run Text=" reseñas"/>
                        </TextBlock>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,24"/>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Categoría:" Style="{StaticResource TextCaption}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Book.CategoryName}" Style="{StaticResource TextBody}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Formato:" Style="{StaticResource TextCaption}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Book.Format}" Style="{StaticResource TextBody}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Páginas:" Style="{StaticResource TextCaption}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Book.PageCount}" Style="{StaticResource TextBody}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Publicado:" Style="{StaticResource TextCaption}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Book.PublishedYear}" Style="{StaticResource TextBody}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Vendedor:" Style="{StaticResource TextCaption}" Margin="0,0,16,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Book.VendorName}" Style="{StaticResource TextBody}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,24"/>

                    <TextBlock Text="Descripción" Style="{StaticResource TextSubhead}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Book.Description}" Style="{StaticResource TextBody}"
                               TextWrapping="Wrap" Margin="0,0,0,32"/>

                    <TextBlock Text="Reseñas" Style="{StaticResource TextSubhead}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Book.Reviews}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="{Binding UserFullName}"
                                                       Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}"
                                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Rating}"
                                                           Style="{StaticResource TextCaption}"
                                                           Margin="4,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Comment}" Style="{StaticResource TextBody}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Este libro aún no tiene reseñas."
                               HorizontalAlignment="Center" Margin="0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Book.ReviewCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
