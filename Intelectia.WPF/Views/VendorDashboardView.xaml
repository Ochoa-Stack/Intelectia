<UserControl x:Class="Intelectia.WPF.Views.VendorDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header con tabs integrados -->
        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GoToMarketplaceCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Padding="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconArrowLeft}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Marketplace"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Panel de Vendedor"
                           Style="{StaticResource TextHeading}" Margin="0,0,32,0"
                           VerticalAlignment="Center"/>

                <!-- Tabs -->
                <Button Command="{Binding SwitchTabCommand}" CommandParameter="inventory"
                        Background="Transparent" BorderThickness="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPackage}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Inventario" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInventoryTab}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Command="{Binding SwitchTabCommand}" CommandParameter="stats"
                        Background="Transparent" BorderThickness="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBarChart}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Estadísticas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStatsTab}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Command="{Binding SwitchTabCommand}" CommandParameter="publish"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlus}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Publicar libro" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPublishTab}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Contenido -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32">
            <StackPanel>

                <!-- Tab: Inventario -->
                <StackPanel Visibility="{Binding IsInventoryTab, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Sin libros -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,60"
                                Visibility="{Binding HasBooks, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Path Data="{StaticResource IconPackage}"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Width="48" Height="48" Stretch="Uniform"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="No tienes libros publicados"
                                   Style="{StaticResource TextSubhead}"
                                   HorizontalAlignment="Center" Margin="0,16,0,8"/>
                        <Button Content="Publicar mi primer libro"
                                Command="{Binding SwitchTabCommand}"
                                CommandParameter="publish"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0" Padding="24,10"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Lista de libros -->
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource TextBody}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Author}"
                                                       Style="{StaticResource TextCaption}"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Style="{StaticResource TextCaption}"
                                                       Margin="0,4,0,0">
                                                <Run Text="{Binding CategoryName}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Format}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="16,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TextBody}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Right">
                                                <Run Text="$"/>
                                                <Run Text="{Binding Price, StringFormat='{}{0:F2}'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="16,0"
                                                    VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding AverageRating, StringFormat='{}{0:F1}'}"
                                                       Style="{StaticResource TextCaption}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <Border Grid.Column="3" Padding="8,4"
                                                CornerRadius="4"
                                                Background="{StaticResource SurfaceLightBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource TextCaption}"
                                                       Foreground="{StaticResource SuccessBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Tab: Estadísticas -->
                <StackPanel Visibility="{Binding IsStatsTab, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,0,0,24"
                          Visibility="{Binding Stats, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tarjeta: Libros -->
                        <Border Grid.Column="0" Margin="0,0,12,0"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12" Padding="20">
                            <StackPanel>
                                <Path Data="{StaticResource IconBooks}"
                                      Fill="{StaticResource PrimaryBrush}"
                                      Width="32" Height="32" Stretch="Uniform"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Stats.TotalBooks}"
                                           Style="{StaticResource TextHeading}"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Libros publicados"
                                           Style="{StaticResource TextCaption}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta: Ventas -->
                        <Border Grid.Column="1" Margin="6,0"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12" Padding="20">
                            <StackPanel>
                                <Path Data="{StaticResource IconCart}"
                                      Fill="{StaticResource PrimaryBrush}"
                                      Width="32" Height="32" Stretch="Uniform"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Stats.TotalSales}"
                                           Style="{StaticResource TextHeading}"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Ventas totales"
                                           Style="{StaticResource TextCaption}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta: Ingresos -->
                        <Border Grid.Column="2" Margin="12,0,0,0"
                                Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12" Padding="20">
                            <StackPanel>
                                <Path Data="{StaticResource IconMoney}"
                                      Fill="{StaticResource SuccessBrush}"
                                      Width="32" Height="32" Stretch="Uniform"
                                      HorizontalAlignment="Center"/>
                                <TextBlock Style="{StaticResource TextHeading}"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource SuccessBrush}">
                                    <Run Text="$"/>
                                    <Run Text="{Binding Stats.TotalRevenue, StringFormat='{}{0:F2}'}"/>
                                </TextBlock>
                                <TextBlock Text="Ingresos totales"
                                           Style="{StaticResource TextCaption}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Libro más vendido -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8" Padding="16"
                            Visibility="{Binding Stats, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Libro más vendido"
                                       Style="{StaticResource TextSubhead}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource TextBody}"
                                       Foreground="{StaticResource PrimaryBrush}">
                                <Run Text="{Binding Stats.TopBookTitle}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab: Publicar -->
                <StackPanel Visibility="{Binding IsPublishTab, Converter={StaticResource BoolToVisibilityConverter}}"
                            MaxWidth="600" HorizontalAlignment="Left">

                    <TextBlock Text="Publicar nuevo libro"
                               Style="{StaticResource TextSubhead}"
                               Margin="0,0,0,24"/>

                    <!-- Mensaje de éxito -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Style="{StaticResource TextBody}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Formulario -->
                    <StackPanel>
                        <TextBlock Text="Título" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BookTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Autor" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BookAuthor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                        <TextBlock Text="Descripción" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BookDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="120" VerticalScrollBarVisibility="Auto"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Precio ($)" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BookPrice, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock Text="Año" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BookPublishedYear, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="Páginas" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding BookPageCount, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Categoría" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedCategory}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Formato" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Formats}"
                                          SelectedItem="{Binding SelectedFormat}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Mensaje de error -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Style="{StaticResource TextCaption}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Button Content="Publicar libro"
                                Command="{Binding PublishBookCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0" Padding="24,12"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
