<UserControl x:Class="Intelectia.WPF.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Intelectia.WPF.Controls"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header con tabs integrados -->
        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GoToMarketplaceCommand}"
                        Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Padding="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconArrowLeft}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Marketplace"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Mi Perfil" Style="{StaticResource TextHeading}" Margin="0,0,32,0"
                           VerticalAlignment="Center"/>

                <!-- Tabs -->
                <Button Command="{Binding SwitchTabCommand}" CommandParameter="profile"
                        Background="Transparent" BorderThickness="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconUser}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Datos personales"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProfileTab}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Command="{Binding SwitchTabCommand}" CommandParameter="security"
                        Background="Transparent" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconLock}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Seguridad"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSecurityTab}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- Grid contenido -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar izquierdo -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="24">
                <Grid>
                    <StackPanel>
                        <!-- Imagotipo mediano en sidebar -->
                        <controls:IntelectiaLogo IconSize="24"
                                                 FontSize="14"
                                                 ShowWordmark="Visible"
                                                 HorizontalAlignment="Left"
                                                 Margin="0,0,0,20"/>

                        <!-- Avatar circular -->
                        <Border Width="80" Height="80" CornerRadius="40"
                                Background="{StaticResource PrimaryBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconUser}"
                                  Fill="White"
                                  Width="36" Height="36" Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Style="{StaticResource TextHeading}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4">
                            <Run Text="{Binding FirstName}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding LastName}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding Email}" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Chips de roles -->
                        <StackPanel Margin="0,0,0,24">
                            <Border Padding="10,4" CornerRadius="12" Background="{StaticResource PrimaryBrush}" Margin="0,0,0,8"
                                    Visibility="{Binding IsStudent, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Estudiante" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Padding="10,4" CornerRadius="12" Background="{StaticResource SecondaryBrush}"
                                    Visibility="{Binding IsVendor, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Vendedor" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Command="{Binding LogoutCommand}" Background="Transparent" BorderThickness="0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Padding="0,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Cerrar sesión" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Panel derecho -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="48,32">
                <StackPanel MaxWidth="480" HorizontalAlignment="Left">

                    <!-- Mensajes de feedback -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8" Padding="14"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Style="{StaticResource TextBody}"/>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8" Padding="14"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Style="{StaticResource TextBody}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Tab: Datos personales -->
                    <StackPanel Visibility="{Binding IsProfileTab, Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock Text="Correo electrónico"
                                   Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource SurfaceBrush}"
                                CornerRadius="4" Padding="12,10"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" Margin="0,0,0,16">
                            <TextBlock Text="{Binding Email}"
                                       Style="{StaticResource TextBody}"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>

                        <TextBlock Text="Nombre" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                        <TextBlock Text="Apellido" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24"/>

                        <Button Content="Guardar cambios"
                                Command="{Binding SaveProfileCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0" Padding="24,12"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                    <!-- Tab: Seguridad -->
                    <StackPanel Visibility="{Binding IsSecurityTab, Converter={StaticResource BoolToVisibilityConverter}}">

                        <TextBlock Text="Cambiar contraseña"
                                   Style="{StaticResource TextSubhead}" Margin="0,0,0,24"/>

                        <TextBlock Text="Contraseña actual" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="CurrentPasswordBox"
                                     PasswordChanged="CurrentPasswordBox_PasswordChanged" Margin="0,0,0,16"/>

                        <TextBlock Text="Nueva contraseña" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     PasswordChanged="NewPasswordBox_PasswordChanged" Margin="0,0,0,16"/>

                        <TextBlock Text="Confirmar nueva contraseña" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     PasswordChanged="ConfirmPasswordBox_PasswordChanged" Margin="0,0,0,24"/>

                        <TextBlock Style="{StaticResource TextCaption}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="La contraseña debe tener al menos 8 caracteres, una mayúscula y un número."/>

                        <Button Content="Cambiar contraseña"
                                Command="{Binding ChangePasswordCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0" Padding="24,12"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
