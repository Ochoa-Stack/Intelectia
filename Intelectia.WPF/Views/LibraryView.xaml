<UserControl x:Class="Intelectia.WPF.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GoToMarketplaceCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Padding="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconArrowLeft}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Marketplace"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Mi Biblioteca" Style="{StaticResource TextHeading}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="24,0">

                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="books"
                        Background="Transparent"
                        Padding="0,12" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBooks}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Mis Libros"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBookTab}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Command="{Binding SwitchTabCommand}"
                        CommandParameter="notes"
                        Background="Transparent"
                        Padding="0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconNote}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Mis Notas"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotesTab}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>

        <!-- Contenido principal -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>

                <!-- ══ TAB: MIS LIBROS ══ -->
                <StackPanel Visibility="{Binding IsBookTab, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Estado vacío -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,60"
                                Visibility="{Binding HasBooks, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Path Data="{StaticResource IconBooks}"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Width="48" Height="48" Stretch="Uniform"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="No tienes libros en tu biblioteca"
                                   Style="{StaticResource TextSubhead}"
                                   HorizontalAlignment="Center" Margin="0,16,0,8"/>
                        <TextBlock Text="Adquiere libros en el Marketplace para verlos aquí."
                                   Style="{StaticResource TextCaption}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <Button Content="Ir al Marketplace"
                                Command="{Binding GoToMarketplaceCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0" Padding="24,10"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Grid de libros adquiridos -->
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="180" Margin="0,0,16,16"
                                        Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <!-- Portada -->
                                        <Border Height="220" CornerRadius="12,12,0,0"
                                                Background="{StaticResource SurfaceLightBrush}">
                                            <Path Data="{StaticResource IconBook}"
                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                  Width="40" Height="40" Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Datos del libro -->
                                        <StackPanel Margin="12">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource TextBody}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="40"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Author}"
                                                       Style="{StaticResource TextCaption}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,8"/>

                                            <!-- Progreso de lectura -->
                                            <ProgressBar Value="{Binding ReadingProgress}"
                                                         Minimum="0" Maximum="100"
                                                         Height="4"
                                                         Background="{StaticResource SurfaceLightBrush}"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         BorderThickness="0"
                                                         Margin="0,0,0,4"/>
                                            <TextBlock Style="{StaticResource TextCaption}">
                                                <Run Text="{Binding ReadingProgress, StringFormat='{}{0:F0}'}"/>
                                                <Run Text="% leído"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ══ TAB: MIS NOTAS ══ -->
                <StackPanel Visibility="{Binding IsNotesTab, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Botón nueva nota -->
                    <Button Command="{Binding ToggleNoteFormCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="16,8"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nueva nota" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Formulario de nota nueva -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8" Padding="16" Margin="0,0,0,16"
                            Visibility="{Binding ShowNoteForm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Nueva nota" Style="{StaticResource TextSubhead}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Título" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewNoteTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                            <TextBlock Text="Contenido" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewNoteContent, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="100" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Guardar"
                                        Command="{Binding SaveNoteCommand}"
                                        Background="{StaticResource PrimaryBrush}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        BorderThickness="0" Padding="16,8" Margin="0,0,8,0"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                                <Button Content="Cancelar"
                                        Command="{Binding ToggleNoteFormCommand}"
                                        Background="Transparent"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="0" Padding="16,8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Estado vacío de notas -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,40"
                                Visibility="{Binding HasNotes, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Path Data="{StaticResource IconNote}"
                              Fill="{StaticResource TextSecondaryBrush}"
                              Width="48" Height="48" Stretch="Uniform"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="No tienes notas todavía"
                                   Style="{StaticResource TextSubhead}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>

                    <!-- Lista de notas -->
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <StackPanel Margin="0,0,32,0">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource TextBody}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Content}"
                                                       Style="{StaticResource TextBody}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="80"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource TextCaption}"
                                                       Margin="0,8,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                                <Run Text=" — Pág. "/>
                                                <Run Text="{Binding PageNumber}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Botón eliminar -->
                                        <Button Command="{Binding DataContext.DeleteNoteCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                Foreground="{StaticResource ErrorBrush}"
                                                BorderThickness="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Padding="8">
                                            <Path Data="{StaticResource IconX}" Fill="{StaticResource ErrorBrush}"
                                                  Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Mensaje de error global -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           Style="{StaticResource TextCaption}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                           Margin="0,8" TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
