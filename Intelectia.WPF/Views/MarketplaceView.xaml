<UserControl x:Class="Intelectia.WPF.Views.MarketplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral de filtros -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Margin="0,0,1,0">
            <StackPanel Margin="16">

                <TextBlock Text="Filtros" Style="{StaticResource TextSubhead}" Margin="0,0,0,16"/>

                <!-- Búsqueda -->
                <TextBlock Text="Buscar" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource SurfaceLightBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8,6" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="🔍"
                            Command="{Binding SearchCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="8,6" Margin="4,0,0,0"/>
                </Grid>

                <!-- Categorías -->
                <TextBlock Text="Categoría" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,16">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" Padding="4,6"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Ordenamiento -->
                <TextBlock Text="Ordenar por" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Label"
                          SelectedValue="{Binding SelectedSortBy}"
                          Background="{StaticResource SurfaceLightBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          Padding="8,6"/>

            </StackPanel>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Marketplace" Style="{StaticResource TextHeading}" VerticalAlignment="Center"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextCaption}">
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text="libros disponibles"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Accesos rápidos del header -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Cargando..." Style="{StaticResource TextCaption}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="📚 Mi Biblioteca"
                                Command="{Binding GoToLibraryCommand}"
                                Background="Transparent"
                                Foreground="{StaticResource PrimaryBrush}"
                                BorderThickness="0" Padding="0"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grid de libros -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <ItemsControl ItemsSource="{Binding Books}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Margin="0,0,16,16"
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="12" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenBookCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <!-- Portada -->
                                    <Border Height="220" CornerRadius="12,12,0,0"
                                            Background="{StaticResource SurfaceLightBrush}">
                                        <TextBlock Text="📖" FontSize="48"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Datos -->
                                    <StackPanel Margin="12">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="40" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Author}" Style="{StaticResource TextCaption}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                        <Grid>
                                            <TextBlock Style="{StaticResource TextBody}" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}">
                                                <Run Text="$"/>
                                                <Run Text="{Binding Price, StringFormat='{}{0:F2}'}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding CategoryName}"
                                                       Style="{StaticResource TextCaption}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="★" Foreground="{StaticResource WarningBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource TextCaption}" Margin="4,0,0,0">
                                                <Run Text="{Binding AverageRating, StringFormat='{}{0:F1}'}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding ReviewCount}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Paginación -->
            <Border Grid.Row="2" Padding="24,12" Background="{StaticResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="← Anterior"
                            Command="{Binding PreviousPageCommand}"
                            Background="{StaticResource SurfaceLightBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="16,8" Margin="0,0,8,0"
                            IsEnabled="{Binding HasPreviousPage}"/>
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Style="{StaticResource TextBody}">
                        <Run Text="Página"/>
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text="de"/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="Siguiente →"
                            Command="{Binding NextPageCommand}"
                            Background="{StaticResource SurfaceLightBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="16,8" Margin="8,0,0,0"
                            IsEnabled="{Binding HasNextPage}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
