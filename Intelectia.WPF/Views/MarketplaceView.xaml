<UserControl x:Class="Intelectia.WPF.Views.MarketplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Intelectia.WPF.Controls"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral de filtros -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Margin="0,0,1,0">
            <StackPanel Margin="16">

                <TextBlock Text="Filtros" Style="{StaticResource TextSubhead}" Margin="0,0,0,16"/>

                <!-- Búsqueda -->
                <TextBlock Text="Buscar" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1"
                            Command="{Binding SearchCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="10,6" Margin="4,0,0,0">
                        <Path Data="{StaticResource IconSearch}"
                              Fill="White" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- Categori­as -->
                <TextBlock Text="Categoría" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}" Margin="0,0,0,16">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" Padding="4,6"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Ordenamiento -->
                <TextBlock Text="Ordenar por" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding SortOptions}"
                          SelectedValuePath="Key"
                          DisplayMemberPath="Label"
                          SelectedValue="{Binding SelectedSortBy}" SelectionChanged="ComboBox_SelectionChanged"/>

            </StackPanel>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <!-- Logo compacto: solo ícono en el header -->
                        <controls:IntelectiaLogo IconSize="28"
                                                 FontSize="16"
                                                 ShowWordmark="Collapsed"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>
                        <TextBlock Text="Marketplace" Style="{StaticResource TextHeading}" VerticalAlignment="Center"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextCaption}">
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text="libros disponibles"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Accesos rapidos del header -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Skeleton loaders mientras carga el catálogo -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <controls:SkeletonLoader Width="80" Height="16" Margin="0,0,8,0"/>
                            <controls:SkeletonLoader Width="120" Height="16"/>
                        </StackPanel>
                        <Button Command="{Binding GoToProfileCommand}"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUser}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Perfil"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoToGroupsCommand}"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconUsers}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Grupos"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoToVendorDashboardCommand}"
                                Background="Transparent"
                                Foreground="{StaticResource SecondaryBrush}"
                                BorderThickness="0" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconStore}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mi Tienda"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GoToLibraryCommand}"
                                Background="Transparent"
                                Foreground="{StaticResource PrimaryBrush}"
                                BorderThickness="0" Padding="0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconBooks}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Mi Biblioteca"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grid de libros -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <ItemsControl ItemsSource="{Binding Books}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Margin="0,0,16,16"
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="12" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenBookCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <StackPanel>
                                    <!-- Portada -->
                                    <Border Height="220" CornerRadius="12,12,0,0"
                                            Background="{StaticResource SurfaceLightBrush}">
                                        <Path Data="{StaticResource IconBook}"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="40" Height="40" Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Datos -->
                                    <StackPanel Margin="10,8,10,10">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="36" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Author}" Style="{StaticResource TextCaption}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,8"/>
                                        
                                        <TextBlock Style="{StaticResource TextBody}" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   TextWrapping="NoWrap">
                                            <Run Text="$"/>
                                            <Run Text="{Binding Price, StringFormat='{}{0:F2}'}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CategoryName}"
                                                   Style="{StaticResource TextCaption}"
                                                   TextWrapping="NoWrap"
                                                   Margin="0,0,0,4"/>
                                        
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}"
                                                  Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource TextCaption}" Margin="4,0,0,0" TextWrapping="NoWrap">
                                                <Run Text="{Binding AverageRating, StringFormat='{}{0:F1}'}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding ReviewCount}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Paginación -->
            <Border Grid.Row="2" Padding="24,12" Background="{StaticResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding PreviousPageCommand}"
                            Background="{StaticResource SurfaceLightBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="16,8" Margin="0,0,8,0"
                            IsEnabled="{Binding HasPreviousPage}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Anterior" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <TextBlock VerticalAlignment="Center" Margin="8,0" Style="{StaticResource TextBody}">
                        <Run Text="Página"/>
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text="de"/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Command="{Binding NextPageCommand}"
                            Background="{StaticResource SurfaceLightBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="16,8" Margin="8,0,0,0"
                            IsEnabled="{Binding HasNextPage}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Siguiente" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
