<UserControl x:Class="Intelectia.WPF.Views.Auth.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Margin="0,40">
            <StackPanel>

                <TextBlock Text="Crear cuenta"
                           Style="{StaticResource TextHeading}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Nombre" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="12,10" BorderThickness="1" Margin="0,0,0,12"/>

                <TextBlock Text="Apellido" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="12,10" BorderThickness="1" Margin="0,0,0,12"/>

                <TextBlock Text="Correo electrónico" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="12,10" BorderThickness="1" Margin="0,0,0,12"/>

                <TextBlock Text="Contraseña" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="12,10" BorderThickness="1" Margin="0,0,0,12"/>

                <TextBlock Text="Confirmar contraseña" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="12,10" BorderThickness="1" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           Style="{StaticResource TextCaption}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Button Content="Crear cuenta"
                        Command="{Binding RegisterCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Padding="0,12" BorderThickness="0"
                        Margin="0,0,0,16"/>

                <Button Content="¿Ya tienes cuenta? Inicia sesión"
                        Command="{Binding GoToLoginCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0"
                        HorizontalAlignment="Center" Padding="0"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
