<UserControl x:Class="Intelectia.WPF.Views.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>

            <TextBlock Text="Iniciar sesión"
                       Style="{StaticResource TextHeading}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Correo electrónico" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource SurfaceBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     Padding="12,10" BorderThickness="1"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Contraseña" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         PasswordChanged="PasswordBox_PasswordChanged"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="12,10" BorderThickness="1"
                         Margin="0,0,0,12"/>

            <!-- Mensaje de error -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       Style="{StaticResource TextCaption}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Button Content="Entrar"
                    Command="{Binding LoginCommand}"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Padding="0,12"
                    BorderThickness="0"
                    Margin="0,0,0,8"/>

            <Button Content="Continuar con Google"
                    Command="{Binding LoginWithGoogleCommand}"
                    Background="{StaticResource SurfaceLightBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="0,12"
                    Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="¿No tienes cuenta? Regístrate"
                        Command="{Binding GoToRegisterCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Padding="0"
                        Margin="0,0,8,0"/>
                <TextBlock Text="|" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="¿Olvidaste tu contraseña?"
                        Command="{Binding GoToForgotPasswordCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" Padding="0"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
