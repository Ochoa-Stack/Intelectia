<UserControl x:Class="Intelectia.WPF.Views.Auth.ForgotPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Intelectia.WPF.Controls"
             Background="{StaticResource BackgroundBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <StackPanel>

            <!-- Imagotipo completo -->
            <controls:IntelectiaLogo IconSize="40"
                                     FontSize="22"
                                     ShowWordmark="Visible"
                                     HorizontalAlignment="Center"
                                     Margin="0,0,0,24"/>

            <TextBlock Text="Recuperar contraseña"
                       Style="{StaticResource TextHeading}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Ingresa tu correo y te enviaremos instrucciones."
                       Style="{StaticResource TextCaption}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Correo electrónico" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- Mensaje de error -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       Style="{StaticResource TextCaption}"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Mensaje de éxito -->
            <TextBlock Text="{Binding SuccessMessage}"
                       Foreground="{StaticResource SuccessBrush}"
                       Style="{StaticResource TextCaption}"
                       Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <Button Content="Enviar instrucciones"
                    Command="{Binding SendResetEmailCommand}"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Padding="0,12" BorderThickness="0"
                    Margin="0,0,0,16"/>

            <Button Content="Volver al login"
                    Command="{Binding GoToLoginCommand}"
                    Background="Transparent"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    BorderThickness="0"
                    HorizontalAlignment="Center" Padding="0"/>

        </StackPanel>
    </Grid>
</UserControl>
