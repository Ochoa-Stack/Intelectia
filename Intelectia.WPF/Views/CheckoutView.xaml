<UserControl x:Class="Intelectia.WPF.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GoBackCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Padding="0"
                        Margin="0,0,24,0"
                        IsEnabled="{Binding OrderConfirmed, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconArrowLeft}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Carrito"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="Checkout" Style="{StaticResource TextHeading}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: resumen del pedido -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="32">
                <StackPanel>
                    <TextBlock Text="Resumen del pedido" Style="{StaticResource TextSubhead}" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceLightBrush}"
                                        CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="{StaticResource IconBook}"
                                              Fill="{StaticResource TextSecondaryBrush}"
                                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BookTitle}"
                                                   Style="{StaticResource TextBody}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource TextBody}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            <Run Text="$"/>
                                            <Run Text="{Binding PriceSnapshot, StringFormat='{}{0:F2}'}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,16"/>

                    <Grid>
                        <TextBlock Text="Total" Style="{StaticResource TextSubhead}" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource TextSubhead}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Right" FontWeight="Bold">
                            <Run Text="$"/>
                            <Run Text="{Binding Total, StringFormat='{}{0:F2}'}"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Columna derecha: panel de pago (fijo) -->
            <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" Padding="32">
                <StackPanel>
                    <!-- Tarjeta de éxito post-confirmación -->
                    <StackPanel Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Path Data="{StaticResource IconCheck}"
                                  Fill="{StaticResource SuccessBrush}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Pedido confirmado"
                                       Style="{StaticResource TextSubhead}"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Style="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,16"/>
                        <Button Content="Ver mis pedidos"
                                Command="{Binding ViewOrdersCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0" Padding="24,10"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Panel de confirmación — oculto después de pagar -->
                    <StackPanel Visibility="{Binding OrderConfirmed, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   Style="{StaticResource TextCaption}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Style="{StaticResource TextCaption}"
                                   TextWrapping="Wrap" Margin="0,0,0,16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Al confirmar se generará tu pedido y se procesará el pago vía Stripe Sandbox."/>

                        <Button Content="Confirmar pedido y pagar"
                                Command="{Binding ConfirmOrderCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0" Padding="24,12"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
