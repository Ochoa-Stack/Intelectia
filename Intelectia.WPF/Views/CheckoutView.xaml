<UserControl x:Class="Intelectia.WPF.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Carrito"
                        Command="{Binding GoBackCommand}"
                        Background="Transparent"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Padding="0"
                        Margin="0,0,24,0"
                        IsEnabled="{Binding OrderConfirmed, Converter={StaticResource InverseBoolConverter}}"/>
                <TextBlock Text="Checkout" Style="{StaticResource TextHeading}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">

                <!-- Resumen del pedido -->
                <TextBlock Text="Resumen del pedido"
                           Style="{StaticResource TextSubhead}"
                           Margin="0,0,0,12"/>

                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8" Padding="16" Margin="0,0,0,24">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding BookTitle}"
                                                   Style="{StaticResource TextBody}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource TextBody}"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource PrimaryBrush}">
                                            <Run Text="$"/>
                                            <Run Text="{Binding PriceSnapshot, StringFormat='{}{0:F2}'}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,12"/>

                        <Grid>
                            <TextBlock Text="Total" Style="{StaticResource TextSubhead}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource TextSubhead}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Right" FontWeight="Bold">
                                <Run Text="$"/>
                                <Run Text="{Binding Total, StringFormat='{}{0:F2}'}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tarjeta de éxito post-confirmación -->
                <Border Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8" Padding="20"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="✅  Pedido confirmado"
                                   Style="{StaticResource TextSubhead}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Style="{StaticResource TextBody}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,16"/>
                        <Button Content="Ver mis pedidos"
                                Command="{Binding ViewOrdersCommand}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0" Padding="24,10"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Panel de confirmación — oculto después de pagar -->
                <StackPanel Visibility="{Binding OrderConfirmed, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               Style="{StaticResource TextCaption}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Style="{StaticResource TextCaption}"
                               TextWrapping="Wrap" Margin="0,0,0,16"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Al confirmar se generará tu pedido y se procesará el pago vía Stripe Sandbox."/>

                    <Button Content="Confirmar pedido y pagar"
                            Command="{Binding ConfirmOrderCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            BorderThickness="0" Padding="24,12"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
