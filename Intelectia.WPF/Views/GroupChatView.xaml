<UserControl x:Class="Intelectia.WPF.Views.GroupChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16" Background="{StaticResource SurfaceBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GoBackCommand}"
                        Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                        BorderThickness="0" Padding="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconArrowLeft}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Grupos"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding Group.Name}"
                               Style="{StaticResource TextSubhead}"
                               VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="{Binding Group.MemberCount}"/>
                        <Run Text=" miembros"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Mensajes -->
        <ScrollViewer Grid.Row="1" x:Name="MessagesScroll"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,12">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding UserFullName}"
                                               Style="{StaticResource TextCaption}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:HH:mm}'}"
                                               Style="{StaticResource TextCaption}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        CornerRadius="0,8,8,8"
                                        Padding="12,8"
                                        HorizontalAlignment="Left"
                                        MaxWidth="500">
                                    <TextBlock Text="{Binding Content}"
                                               Style="{StaticResource TextBody}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Indicador de escritura -->
        <TextBlock Grid.Row="2"
                   Text="{Binding TypingIndicator}"
                   Style="{StaticResource TextCaption}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="24,0,24,4"
                   Visibility="{Binding TypingIndicator,
                       Converter={StaticResource NullToVisibilityConverter}}"/>

        <!-- Input de mensaje -->
        <Border Grid.Row="3" Padding="16" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="MessageInput"
                         Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         MaxHeight="100"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="MessageInput_TextChanged"
                         KeyDown="MessageInput_KeyDown"/>

                <Button Grid.Column="1"
                        Content="Enviar"
                        Command="{Binding SendMessageCommand}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        BorderThickness="0" Padding="16,10"
                        Margin="8,0,0,0"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
