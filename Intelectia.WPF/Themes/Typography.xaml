<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Poppins e Inter son fuentes externas.
        Si no están instaladas en el sistema, WPF cae al font fallback del sistema.
        En Fase 8 (Polish) se embeben como recursos del proyecto.
    -->
    <FontFamily x:Key="FontPoppins">Poppins, Segoe UI</FontFamily>
    <FontFamily x:Key="FontInter">Inter, Segoe UI</FontFamily>

    <Style x:Key="TextHeading" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource FontPoppins}"/>
        <Setter Property="FontSize"    Value="24"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextSubhead" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource FontPoppins}"/>
        <Setter Property="FontSize"    Value="18"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize"    Value="14"/>
        <Setter Property="FontWeight"  Value="Normal"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{StaticResource FontInter}"/>
        <Setter Property="FontSize"    Value="12"/>
        <Setter Property="FontWeight"  Value="Normal"/>
        <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

</ResourceDictionary>
