<UserControl x:Class="Intelectia.WPF.Controls.IntelectiaLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Composición: ícono a la izquierda + wordmark "INTELECTIA" a la derecha.
        Se adapta al tamaño que el contenedor le asigne vía IconSize y FontSize.
    -->
    <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

        <!-- Ícono del libro con destello -->
        <Grid Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Margin="0,0,8,0">

            <!-- Libro base (contorno) -->
            <Path Data="M12,5L4.5,8V18L12,21L19.5,18V8L12,5z M12,5V21 M4.5,8L12,11L19.5,8"
                  Stroke="{StaticResource PrimaryBrush}"
                  StrokeThickness="1.5"
                  Fill="Transparent"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>

            <!-- Relleno páginas izquierda -->
            <Path Data="M12,11V21L4.5,18V8L12,11z"
                  Fill="{StaticResource PrimaryBrush}"
                  Opacity="0.25"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>

            <!-- Relleno páginas derecha -->
            <Path Data="M12,11V21L19.5,18V8L12,11z"
                  Fill="{StaticResource PrimaryBrush}"
                  Opacity="0.12"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"/>

            <!-- Destello superior derecho -->
            <Path Data="M18,3.5l0.4,1.1L19.5,5l-1.1,0.4L18,6.5l-0.4-1.1L16.5,5l1.1-0.4z"
                  Fill="{StaticResource SecondaryBrush}"
                  Stretch="Uniform"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right"
                  Width="10" Height="10"
                  Margin="0,-2,-2,0"/>
        </Grid>

        <!-- Wordmark "INTELECTIA" -->
        <TextBlock Text="INTELECTIA"
                   FontFamily="{StaticResource FontPoppins}"
                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   VerticalAlignment="Center"
                   Visibility="{Binding ShowWordmark, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

    </StackPanel>
</UserControl>
