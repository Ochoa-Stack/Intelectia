<Application x:Class="Intelectia.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Intelectia.WPF.Converters"
             xmlns:authVm="clr-namespace:Intelectia.WPF.ViewModels.Auth"
             xmlns:authV="clr-namespace:Intelectia.WPF.Views.Auth"
             xmlns:vm="clr-namespace:Intelectia.WPF.ViewModels"
             xmlns:v="clr-namespace:Intelectia.WPF.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters disponibles en todas las vistas -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

            <!-- DataTemplates de auth -->
            <DataTemplate DataType="{x:Type authVm:LoginViewModel}">
                <authV:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type authVm:RegisterViewModel}">
                <authV:RegisterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type authVm:ForgotPasswordViewModel}">
                <authV:ForgotPasswordView/>
            </DataTemplate>

            <!-- DataTemplates del Marketplace -->
            <DataTemplate DataType="{x:Type vm:MarketplaceViewModel}">
                <v:MarketplaceView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BookDetailViewModel}">
                <v:BookDetailView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
