<Application x:Class="Intelectia.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Intelectia.WPF.Converters"
             xmlns:authVm="clr-namespace:Intelectia.WPF.ViewModels.Auth"
             xmlns:authV="clr-namespace:Intelectia.WPF.Views.Auth">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter disponible en todas las vistas -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Cada DataTemplate conecta un ViewModel con su View correspondiente -->
            <!-- WPF aplica el template correcto automáticamente según el tipo del objeto -->
            <DataTemplate DataType="{x:Type authVm:LoginViewModel}">
                <authV:LoginView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type authVm:RegisterViewModel}">
                <authV:RegisterView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type authVm:ForgotPasswordViewModel}">
                <authV:ForgotPasswordView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
