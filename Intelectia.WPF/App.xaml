<Application x:Class="Intelectia.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Intelectia.WPF.Converters"
             xmlns:authVm="clr-namespace:Intelectia.WPF.ViewModels.Auth"
             xmlns:authV="clr-namespace:Intelectia.WPF.Views.Auth"
             xmlns:vm="clr-namespace:Intelectia.WPF.ViewModels"
             xmlns:v="clr-namespace:Intelectia.WPF.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter          x:Key="BoolToVisibilityConverter"/>
            <converters:NullToVisibilityConverter          x:Key="NullToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter   x:Key="InverseBoolToVisibilityConverter"/>
            <converters:InverseBoolConverter               x:Key="InverseBoolConverter"/>

            <!-- DataTemplates Auth -->
            <DataTemplate DataType="{x:Type authVm:LoginViewModel}">
                <authV:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type authVm:RegisterViewModel}">
                <authV:RegisterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type authVm:ForgotPasswordViewModel}">
                <authV:ForgotPasswordView/>
            </DataTemplate>

            <!-- DataTemplates Marketplace -->
            <DataTemplate DataType="{x:Type vm:MarketplaceViewModel}">
                <v:MarketplaceView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BookDetailViewModel}">
                <v:BookDetailView/>
            </DataTemplate>

            <!-- DataTemplates Comercio -->
            <DataTemplate DataType="{x:Type vm:CartViewModel}">
                <v:CartView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CheckoutViewModel}">
                <v:CheckoutView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OrderHistoryViewModel}">
                <v:OrderHistoryView/>
            </DataTemplate>

            <!-- DataTemplate Biblioteca -->
            <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
                <v:LibraryView/>
            </DataTemplate>

            <!-- DataTemplate Vendedor -->
            <DataTemplate DataType="{x:Type vm:VendorDashboardViewModel}">
                <v:VendorDashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VendorOnboardingViewModel}">
                <v:VendorOnboardingView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
                <v:GroupsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:GroupChatViewModel}">
                <v:GroupChatView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
